# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# Ứng dụng vẫn chạy tốt với bộ tri thức dự phòng tích hợp sẵn ngay cả khi chưa có API key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Cổng khởi chạy máy chủ Express (Mặc định 3000)
PORT=3000

# Đường dẫn URL ứng dụng (tuỳ chọn khi triển khai production)
APP_URL="http://localhost:3000"

